# ==============================================================================
# Enterprise Conference Room Booking System - Environment Configuration Template
# ==============================================================================

# PostgreSQL database connection URL (Must be a real PostgreSQL database in production)
DATABASE_URL="postgresql://username:password@hostname:5432/database_name?sslmode=require"

# NextAuth / Session Configuration
NEXTAUTH_URL="https://your-domain.company.com"
NEXTAUTH_SECRET="generate-a-strong-random-32-byte-hex-secret"

# Super Administrator Configuration (Comma-separated corporate emails)
SUPER_ADMIN_EMAILS="superadmin@company.com,it-director@company.com"

# Initial Administrator Corporate Email (Fallback initial administrator)
INITIAL_ADMIN_EMAIL="admin@company.com"

# Email Delivery Service Configuration (Passwordless Email + OTP)
# Provider options: "resend" | "sendgrid" | "console" (defaults to "console" if unconfigured)
EMAIL_PROVIDER="console"
EMAIL_API_KEY="your-email-provider-api-key"
EMAIL_FROM="Conference Room Booking <noreply@company.com>"

# Gemini AI Assistant API Key
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-3.8-flash"

# Local Development Authentication Bypass
# Set to "true" ONLY for local development (strictly ignored/rejected in production)
DEV_BYPASS_AUTH="true"

# Company Timezone (IANA Time Zone Identifier, e.g. "Asia/Kolkata", "America/New_York")
COMPANY_TIMEZONE="Asia/Kolkata"
