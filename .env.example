# ==============================================================================
# Enterprise Conference Room Booking System - Environment Configuration Template
# ==============================================================================

# PostgreSQL database connection URL (Must be a real PostgreSQL database in production)
DATABASE_URL="postgresql://username:password@hostname:5432/database_name?sslmode=require"

# NextAuth / Auth.js configuration
NEXTAUTH_URL="https://your-domain.company.com"
NEXTAUTH_SECRET="generate-a-strong-random-32-byte-hex-secret"

# Microsoft Entra ID (Azure AD) Credentials
# Obtained from Azure Portal -> Microsoft Entra ID -> App registrations
AZURE_AD_CLIENT_ID="00000000-0000-0000-0000-000000000000"
AZURE_AD_CLIENT_SECRET="your-azure-ad-client-secret-value"
AZURE_AD_TENANT_ID="00000000-0000-0000-0000-000000000000"

# Initial Administrator Provisioning
# Microsoft Object ID (immutable user ID) or enterprise email of initial administrator
INITIAL_ADMIN_MICROSOFT_ID="00000000-0000-0000-0000-000000000000"
INITIAL_ADMIN_EMAIL="it-admin@company.com"

# Company Timezone (IANA Time Zone Identifier, e.g. "Asia/Kolkata", "America/New_York")
COMPANY_TIMEZONE="Asia/Kolkata"

# Isolated development login (Disabled by default in production)
ENABLE_DEV_LOGIN="false"
